# OSINT Privacy Intelligence App Configuration

# Neo4j Graph Database (Optional)
# Set NEO4J_ENABLED=true to enable graph features
# You need to install and run Neo4j separately
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# HIBP API Key (Optional - for breach checking)
# Get a free/paid key from https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
